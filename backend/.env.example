# ==============================================================================
# Sahayak Verification Engine — Backend Environment Configuration
# ==============================================================================

# Server Network Configuration
HOST=127.0.0.1
PORT=8001

# CORS Allowed Origins (Comma-separated for frontend clients)
# Defaults to common local dev ports and production hosts
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# SQLite Database Location
# Defaults to sahayak.db in the backend directory
DATABASE_URL=sqlite:///sahayak.db

# Tesseract OCR Executable Path (Optional)
# If left empty, the engine automatically auto-detects Tesseract from:
# 1. System PATH
# 2. Windows LocalAppData: %LOCALAPPDATA%\Tesseract-OCR\tesseract.exe
# 3. Windows Program Files: C:\Program Files\Tesseract-OCR\tesseract.exe
# 4. Linux standard: /usr/bin/tesseract or /usr/local/bin/tesseract
#
# Examples:
# Windows: TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux:   TESSERACT_CMD=/usr/bin/tesseract
# macOS:   TESSERACT_CMD=/opt/homebrew/bin/tesseract
TESSERACT_CMD=

# File Upload Limits
# Maximum uploaded file size in bytes (15 MB = 15728640)
MAX_FILE_SIZE_BYTES=15728640

# Maximum pages extracted for multi-page PDFs
MAX_PDF_PAGES=10
